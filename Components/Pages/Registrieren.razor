@page "/Registrieren"

<style>
    .message{
        cursor: pointer;
        text-align: center;
    }
    .message p{
        margin-bottom: 0;
        color: #fff;
    }
</style>

<PageTitle>Registrieren</PageTitle>

<div>
<article>
    <h3>Registrieren</h3>
    <p>Registriere dich um EduPlaner zu verwenden!</p>

    <fieldset>
        <label>
                <input type="text" name="Username" placeholder="Text" aria-label="Text">
        </label>
    </fieldset>

    <fieldset>
        <label>
                <input type="password" name="Password" placeholder="Password" aria-label="Password">
        </label>
    </fieldset>

</article>
</div>



